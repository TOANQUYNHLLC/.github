{
	"name": "toanquynh-github",
	"private": true,
	"description": "Công cụ định dạng và kiểm tra cho repository .github của CÔNG TY TNHH TOÀN QUỲNH",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"onFail": "error"
		}
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.12.0",
		"prettier": "3.9.9"
	}
}
