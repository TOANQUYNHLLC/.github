# Mẫu biến môi trường — chép thành .env rồi điền giá trị thật. KHÔNG commit tệp .env.
# Mọi giá trị dưới đây chỉ là ví dụ; ghi chú mỗi biến dùng để làm gì.

# Môi trường chạy: development | staging | production
APP_ENV=development
# Cổng ứng dụng lắng nghe
APP_PORT=3000
# Chuỗi kết nối cơ sở dữ liệu
DATABASE_URL=postgresql://app_user:doi_mat_khau@localhost:5432/app
