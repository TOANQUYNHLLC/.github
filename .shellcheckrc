# Cấu hình ShellCheck cho mọi shell script trong repository (make lint và CI đều đọc tệp này).
# Theo dõi tệp được nạp bằng source để kiểm tra đầy đủ.
external-sources=true
# Bật thêm các kiểm tra tùy chọn mà mã hiện tại đã đáp ứng.
enable=avoid-nullary-conditions,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-double-brackets
